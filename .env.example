# Copy to .env (never commit). Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"      -> SESSION_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"         -> TOTP_ENCRYPTION_KEY
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/solvexa
APP_URL=http://localhost:5173
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=

# console = DEV ONLY (prints emails to the terminal, refused in production). resend = real delivery.
MAIL_TRANSPORT=console
MAIL_FROM="Solvexa <noreply@your-domain.com>"
RESEND_API_KEY=

# Cloudflare Turnstile (needs a domain). Leave unset until then; signup then relies on rate limits + honeypot only.
REQUIRE_TURNSTILE=false
TURNSTILE_SECRET=

# Uploaded files. local = dev only (writes to STORAGE_DIR, refused in production).
# blob = a PRIVATE Vercel Blob store (production). Create one: `vercel blob create-store solvexa-uploads --access private`
# and connect it to the project so BLOB_READ_WRITE_TOKEN (or OIDC) is available to the function.
STORAGE_DRIVER=local
# none = uploads switched off (requests still save; files fail honestly with a clear message).
STORAGE_DIR=.data/uploads
BLOB_READ_WRITE_TOKEN=

# TESTING-ONLY deploys (e.g. a Vercel preview with no Resend yet): lets production mode use console email,
# which then prints verification/reset links into the function logs. NEVER set this for real clients.
ALLOW_DEV_SERVICES=false

# Seed only (npm run db:seed). No default admin credentials exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Client build flags
VITE_SITE_URL=http://localhost:5173
VITE_HIDE_PLACEHOLDERS=false
# Public Turnstile site key (not secret). Leave empty until you have a domain. Then also set REQUIRE_TURNSTILE=true.
VITE_TURNSTILE_SITE_KEY=
