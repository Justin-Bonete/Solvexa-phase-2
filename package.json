{
  "name": "solvexa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,api \"vite\" \"tsx watch --env-file=.env server/dev.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=.env server/dev.ts",
    "build": "npm run build:client && npm run build:ssr && node scripts/prerender.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup-env.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env server/database/migrate.ts",
    "db:seed": "tsx --env-file=.env server/database/seed.ts",
    "admin:reset-mfa": "tsx --env-file=.env server/database/reset-admin-mfa.ts",
    "audit": "npm audit --audit-level=high",
    "size": "node scripts/check-bundle-size.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^3.9.0",
    "@node-rs/argon2": "^2.0.0",
    "@tanstack/react-query": "^5.59.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.0.0",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.8.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
